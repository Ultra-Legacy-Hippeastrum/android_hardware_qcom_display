cc_library_shared {
    name: "libqdutils",
    defaults: ["display_defaults"],
    header_libs: [
        "gl_headers",
        "libhardware_headers",
        "libutils_headers",
        "generated_kernel_headers",
    ],
    shared_libs: [
        "libbinder",
        "libqservice",
        "libui",
        "libhardware",
        "libutils",
    ],
    cflags: [
        "-DLOG_TAG=\"qdutils\"",
        "-Wno-sign-conversion",
        "-Wno-float-conversion",
    ],
    srcs: [
        "profiler.cpp",
        "mdp_version.cpp",
        "idle_invalidator.cpp",
        "comptype.cpp",
        "qd_utils.cpp",
        "cb_utils.cpp",
        "cb_swap_rect.cpp",
    ],
}

cc_library_shared {
    name: "libdisplayconfig",
    defaults: ["display_defaults"],
    cflags: [
        "-Wno-sign-conversion",
        "-DLOG_TAG=\"DisplayMetaData\"",
    ],
    srcs: ["display_config.cpp"],
    shared_libs: [
        "libbinder",
        "libqservice",
        "libqdutils",
        "libui",
        "libhardware",
    ],
}

cc_library_shared {
    name: "libqdMetaData",
    defaults: ["display_defaults"],
    cflags: [
        "-Wno-sign-conversion",
        "-DLOG_TAG=\"DisplayMetaData\"",
    ],
    srcs: ["qdMetaData.cpp","qd_utils.cpp"],
    shared_libs: [
        "libhardware",
    ],
}

// Remove after WFD moves to use libqdMetaData directly
cc_library_shared {
    name: "libqdMetaData.system",
    defaults: ["display_defaults"],
    cflags: [
        "-Wno-sign-conversion",
        "-DLOG_TAG=\"DisplayMetaData\"",
    ],
    srcs: ["qdMetaData.cpp","qd_utils.cpp"],
    shared_libs: [
        "libhardware",
    ],
}